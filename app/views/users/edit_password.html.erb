<% provide(:title, 'Edit Password') %>
<div class="form-style">
  <h1 class="center-text">Edit Password</h1>

  <form action="/update_password" method="post">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

    <div class="field-group">
      <label for="password"> Current Password</label>
      <input type="password" id="password" name="user[password]" required minlength="6" placeholder="Verify current password">
    </div>

    <div class="field-group">
      <label for="new_password"> New Password</label>
      <input type="password" id="new_password" name="user[new_password]" required minlength="6" placeholder="6-20 characters">
    </div>

    <input type="submit" value="Update Password">
    <input type="submit" value="Back to Home" onclick="window.location.href='<%= root_path %>'">

  </form>
</div>