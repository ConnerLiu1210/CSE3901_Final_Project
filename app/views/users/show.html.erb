<% provide(:title,'User Profile')%>

<% if logged_in? %>
<div class="profile-container">
    
    <div class="profile-pic">
        <%= image_tag("User Picture.svg") %>
    </div>
    <div class="profile-information">
        <table class="mytable">
        <thead>
            <tr>
            <th>Attribute</th>
            <th>Details</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td>Name</td>
            <td><%= @user.name %></td>
            </tr>
            <tr>
            <td>Email</td>
            <td><%= @user.email %></td>
            </tr>
            <tr>
            <td>Created At</td>
            <td><%= @user.created_at.strftime('%B %d, %Y') %></td>
            </tr>
            <tr>
            <td>Updated At</td>
            <td><%= @user.updated_at.strftime('%B %d, %Y') %></td>
            </tr>
            <tr>
                <td><%= link_to "Edit Profile", edit_profile_path %><td>
        </tbody>
        </table>
    </div>
  <div class="profile-bio">
    <table class="mytable">
        <thead>
            <tr>
                <th>Bio</th>
            </tr>
        </thead>
        <tbody>
            <tr>
            <td><p><%= @user.bio.present? ? @user.bio : "No bio available." %></p></td>
            </tr>
        <tbody>
    </table>
  </div>
</div>
<% else %>
    <p>You aren't signed in. <%= link_to " Login", login_path %></li> to view your profile.</p>
<% end %>
