<% provide(:title, "My Trips") %>
<h1>My Trips</h1>
<% if @trips.any? %>
  <table class="mytable">
    <thead class="trip-header">
      <tr>
        <td>Trip Name</td>
        <td>Start Date</td>
        <td>End Date</td>
        <td>Participants</td>
        <td>Select</td>
      </tr>
    </thead>
    <tbody>
      <% @trips.each do |trip| %>
        <tr>
          <td><%= trip.trip_name %></td>
          <td><%= trip.start_date %></td>
          <td><%= trip.end_date %></td>
          <td>
            <% if trip.users.size <= 3 %>
              <%= trip.users.map(&:name).join(", ") %>
            <% else %>
              <%= trip.users.first(3).map(&:name).join(", ") %> . . .
            <% end %>
          </td>
          <td><%= link_to "Select", trip_path(trip.id) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <h3>You have no trips planned. Create one to get started.</h3>
  <h3>:)</h3>
<% end %>
<%= button_to "Create New Trip", new_trip_path, method: :get, class: "trip-button" %>
