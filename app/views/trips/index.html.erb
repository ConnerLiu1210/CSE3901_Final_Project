<h1>My Trips</h1>

<%= link_to "New Trip", new_trip_path, class: "btn" %>

<% if @trips.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Dates</th>
        <th>Participants</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @trips.each do |trip| %>
        <tr>
          <td><%= link_to trip.name, trip %></td>
          <td><%= trip.start_date.strftime("%b %d") %> – <%= trip.end_date.strftime("%b %d, %Y") %></td>
          <td><%= trip.members.count %></td>
          <td>
            <%= link_to "View", trip %>
            <% if trip.creator == current_user %>
              | <%= link_to "Edit", edit_trip_path(trip) %>
              | <%= link_to "Delete", trip, data: { turbo_method: :delete, turbo_confirm: "Delete this trip?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No trips yet. Create one!</p>
<% end %>
