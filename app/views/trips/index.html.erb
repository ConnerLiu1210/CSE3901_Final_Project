<% provide(:title, "My Trips") %>
<h1>My Trips</h1>
<% if @trips.any? %>
    <table class="mytable">
        <thead>
            <tr>
                <td>#</td>
                <td>Trip Name</td>
                <td>Start Date</td>
                <td>End Date</td>
                <td>Participants</td>
                <td>Select</td>
                <td>Update</td>
                <td>Delete</td>
            </tr>
        </thead>

        <tbody>
            <% @trips.each do |trip| %>
                <tr>
                    <td><%= trip.id %></td>
                    <td><%= trip.trip_name %></td>
                    <td><%= trip.start_date %></td>
                    <td><%= trip.end_date %></td>
                    <td><%= trip.participants %></td>
                    <td><%= link_to "Select", trip_path(trip.id) %></td>
                    <td><%= link_to "Edit", edit_trip_path(trip.id) %></td>
                    <td><%= button_to "Delete", trip_path(trip.id), method: :delete %></td>
                </tr>
            <% end %>
        </tbody>
    </table>
<% else %>
    <h3>You have no trips planned. Create one to get started.</h3>
    <h3>:)</h3>
<% end %>
<%= button_to "Create new trip", new_trip_path, method: :get %>
