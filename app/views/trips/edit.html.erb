<% provide(:title, "Edit Trip") %>
<%#= render "layouts/partials/trip_error_messages" %>
<%= form_with(model: @trip, html: {class: "form-style"}) do |form| %>
    <h1 class="center-text">Edit Trip</h1>
    <%= form.label :trip_name %>
    <%= form.text_field :trip_name, required: true %>
    <br>
    <br>
    <%= form.label :start_date %>
    <%= form.date_field :start_date, required: true %>
    <br>
    <br>
    <%= form.label :end_date %>
    <%= form.date_field :end_date, required: true %>
    <br>
    <br>
    <%= form.label :user_ids, "Who is coming on this trip?" %>
    <div class="trip-users-list">
        <%= form.collection_check_boxes :user_ids, User.all, :id, :username do |user_box| %>
            <div class="trip-user">
                <%= user_box.label %>
                <%= user_box.check_box %>
            </div>
        <% end %>
    </div>
    <br>
    <br>
    <%= form.submit "Update My Trip" %>
<% end %>
