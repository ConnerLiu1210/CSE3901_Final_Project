<% provide(:title, "Trip") %>
<h1><%= @trip.trip_name %></h1>
<table class="mytable">
    <thead class="trip-header">
        <tr>
            <td>Trip Name</td>
            <td>Start Date</td>
            <td>End Date</td>
            <td>Participants</td>
            <td>Update</td>
            <td>Delete</td>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td><%= @trip.trip_name %></td>
            <td><%= @trip.start_date %></td>
            <td><%= @trip.end_date %></td>
            <td><%= @trip.users.map { |user| user.username }.join(", ") %></td>
            <td><%= link_to "Edit", edit_trip_path(@trip.id) %></td>
            <td><%= button_to "Delete", trip_path(@trip.id), method: :delete %></td>
        </tr>
    </tbody>
</table>
<%= button_to "Back to My Trips", trips_path, method: :get, class: "trip-button" %>
