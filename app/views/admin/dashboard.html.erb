<h1>Admin Panel</h1>

<h2>All Trips</h2>

<% if @trips.any? %>
  <div class="admin-trips-table-wrap">
    <table class="admin-trips-table">
      <thead>
        <tr>
          <th>Trip Name</th>
          <th>Start Date</th>
          <th>End Date</th>
          <th>Participants</th>
          <th>Details</th>
        </tr>
      </thead>
      <tbody>
        <% @trips.each do |trip| %>
          <tr>
            <td><%= trip.trip_name %></td>
            <td><%= trip.start_date %></td>
            <td><%= trip.end_date %></td>
            <td><%= trip.users.map { |u| u.name || u.username }.join(", ") %></td>
            <td><%= link_to "View", trip_path(trip), class: "admin-view-link" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <p>No trips found.</p>
<% end %>