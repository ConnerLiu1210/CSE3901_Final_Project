<%= form_with model: [trip, expense] do |f| %>
  <% if expense.errors.any? %>
    <div style="color: red;">
      <% expense.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :description %>
    <%= f.text_field :description, required: true %>
  </div>

  <div>
    <%= f.label :amount, "Amount ($)" %>
    <%= f.number_field :amount, step: 0.01, min: 0.01, required: true %>
  </div>

  <div>
    <%= f.label :date %>
    <%= f.date_field :date, required: true %>
  </div>

  <div>
    <%= f.label :category %>
    <%= f.select :category, Trip::CATEGORIES %>
  </div>

  <div>
    <label>Split Among (leave all unchecked to split with everyone)</label>
    <% trip.members.each do |member| %>
      <div>
        <%= check_box_tag "expense[participant_ids][]", member.id,
              expense.participants.include?(member),
              id: "participant_#{member.id}" %>
        <%= label_tag "participant_#{member.id}", member.name || member.email %>
      </div>
    <% end %>
  </div>

  <br>
  <%= f.submit %>
<% end %>
