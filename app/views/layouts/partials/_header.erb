<header>
  <nav>
    <ul id="menu">
      <% if logged_in? && current_user.admin? %>
        <li><%= link_to current_user.name, show_path, class: "user-welcome" %></li>
        <li><%= link_to "Home", home_path %></li>
        <li><%= link_to "My Trips", trips_path %></li>
        <li><%= link_to "New Trip", new_trip_path %></li>
        <li><%= link_to "Edit Password", edit_password_path %></li>
        <li><%= link_to "Admin Panel", admin_path %></li>
        <li>
          <%= button_to "Log out", logout_path,
              method: :delete,
              class: "nav-link-button" %>
        </li>

      <% elsif logged_in? %>
        <li><%= link_to current_user.username, show_path, class: "user-welcome" %></li>
        <li><%= link_to "Home", home_path %></li>
        <li><%= link_to "My Trips", trips_path %></li>
        <li><%= link_to "Edit Password", edit_password_path %></li>
        <li>
          <%= button_to "Log out", logout_path,
              method: :delete,
              class: "nav-link-button" %>
        </li>

      <% else %>
        <li><%= link_to "Home", home_path %></li>
        <li><%= link_to "Log in", login_path %></li>
        <li><%= link_to "Sign up", signup_path %></li>

      <% end %>
    </ul>
  </nav>
</header>
